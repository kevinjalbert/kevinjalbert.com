---
// SearchModal.astro - A modal search component using Pagefind
---

<div id="search-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden overflow-x-hidden">
  <div class="flex items-start justify-center min-h-screen pt-4 sm:pt-16 px-2 sm:px-4">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl mx-auto" style="max-width: calc(100vw - 16px)">
      <!-- Search Input -->
      <div class="p-3 sm:p-4 border-b border-gray-200">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search articles..."
            class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-base"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            id="search-close"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Search Results -->
      <div id="search-results" class="max-h-[32rem] sm:max-h-[48rem] lg:max-h-[56rem] overflow-y-auto">
        <div id="search-empty" class="p-6 sm:p-8 text-center text-gray-500 text-sm">
          Start typing to search articles...
        </div>
      </div>

      <!-- Search Footer -->
      <div class="p-3 sm:p-4 border-t border-gray-200 text-xs text-gray-500">
        <div class="flex flex-col sm:flex-row items-center justify-between space-y-2 sm:space-y-0">
          <div class="flex items-center space-x-2 sm:space-x-4">
            <div class="hidden sm:flex items-center">
              <kbd class="px-2 py-1 bg-gray-100 border border-gray-300 rounded text-xs font-mono">↑</kbd>
              <kbd class="px-2 py-1 bg-gray-100 border border-gray-300 rounded text-xs font-mono ml-1">↓</kbd>
              <span class="ml-2">to navigate</span>
            </div>
            <div class="hidden sm:flex items-center">
              <kbd class="px-2 py-1 bg-gray-100 border border-gray-300 rounded text-xs font-mono">↵</kbd>
              <span class="ml-2">to select</span>
            </div>
            <!-- Mobile: simplified instructions -->
            <div class="sm:hidden text-center">
              <span>Tap to select, swipe to navigate</span>
            </div>
          </div>
          <div class="flex items-center">
            <span class="mr-2">Powered by</span>
            <a href="https://pagefind.app" target="_blank" rel="noopener" class="font-medium hover:text-gray-700">Pagefind</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>



<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  mark {
    background-color: #fef08a;
    padding: 0 2px;
    border-radius: 2px;
  }

  kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* Prevent iOS zoom on input focus */
  #search-input {
    font-size: 16px !important;
  }

  /* Ensure the modal doesn't cause horizontal scroll on mobile */
  #search-modal {
    overflow-x: hidden;
  }

  #search-modal .bg-white {
    max-width: calc(100vw - 16px);
    margin-left: auto;
    margin-right: auto;
  }
</style>
