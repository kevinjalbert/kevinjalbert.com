---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { calculateReadTimeFromMarkdown } from '../utils/readTime';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  // Sort by date (newest first) using pubDate from frontmatter
  const sortedPosts = blogEntries.sort((a, b) => {
    const dateA = new Date(a.data.pubDate);
    const dateB = new Date(b.data.pubDate);
    return dateB.getTime() - dateA.getTime();
  });

  return sortedPosts.map((entry, index) => {
    // Get previous and next posts for navigation
    const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    const nextPost = index > 0 ? sortedPosts[index - 1] : null;

    return {
      params: { slug: entry.data.permalink },
      props: {
        entry,
        prevPost,
        nextPost
      },
    };
  });
}

const { entry, prevPost, nextPost } = Astro.props;
const { Content } = await entry.render();

// Calculate read time
const readTime = calculateReadTimeFromMarkdown(entry.body);

// Use pubDate from frontmatter for display
const publishDate = new Date(entry.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Process markdown in image attribution if it exists
const processedHeroImageAlt = entry.data.heroImageAlt ? marked.parseInline(entry.data.heroImageAlt) : null;
const processedPullImageAttribution = entry.data.pull_image_attribution ? marked.parseInline(entry.data.pull_image_attribution) : null;

// Helper function to get clean slug for any post
function getCleanSlug(post) {
  return post.data.permalink;
}
// Generate canonical URL for this post
const canonicalURL = `https://kevinjalbert.com/${entry.data.permalink}/`;
---

<Layout title={entry.data.title} description={entry.data.description} canonical={canonicalURL}>
  <!-- Post Title - Outside the article but still indexed by pagefind -->
  <div class="text-center mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900" data-pagefind-meta="title">{entry.data.title}</h1>
  </div>

  <!-- Hero Image - Outside article container for faster loading -->
  {entry.data.heroImage && (
    <div class="mb-2">
      <div class="relative">
        <img
          src={entry.data.heroImage.src}
          alt={processedHeroImageAlt || entry.data.title}
          class="w-full h-64 sm:h-80 object-cover rounded-lg"
          loading="eager"
          fetchpriority="high"
        />
        {entry.data.pull_image_attribution && (
          <div class="absolute bottom-2 right-2 bg-black bg-opacity-50 text-white text-xs px-2 py-1 rounded">
            <span set:html={processedPullImageAttribution} />
          </div>
        )}
      </div>
      {entry.data.heroImageAlt && (
        <div class="py-2">
          <p class="text-xs text-gray-500 text-center italic [&_a]:text-blue-600 [&_a:hover]:text-blue-800 [&_a]:transition-colors" set:html={processedHeroImageAlt} />
        </div>
      )}
    </div>
  )}

  <article class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden" data-pagefind-body>
    <!-- Hidden metadata for Pagefind -->
    <div style="display: none;">
      <span data-pagefind-meta="date">{publishDate}</span>
      {entry.data.description && (
        <span data-pagefind-meta="description">{entry.data.description}</span>
      )}
    </div>

    <!-- Article Header -->
    <div class="p-6 sm:p-8 border-b border-gray-100">
      <!-- Metadata and Tags in a more compact layout -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-0">
        {publishDate && (
          <div class="flex items-center justify-center sm:justify-start text-gray-500 text-sm space-x-4">
            <time>{publishDate}</time>
            <span>•</span>
            <span>{readTime.text}</span>
          </div>
        )}

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 justify-center sm:justify-end" data-pagefind-ignore>
          {entry.data.tags.map(tag => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="inline-block bg-blue-50 text-blue-700 text-xs px-2 py-1 rounded-full hover:bg-blue-100 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Article Content -->
    <div class="p-6 sm:p-8">
      <div class="prose max-w-none prose-headings:text-gray-900 prose-h1:mt-8 prose-h2:mt-6 prose-h3:mt-5 prose-h4:mt-4 [&>*:first-child]:mt-0 prose-li:my-1 prose-ul:pl-4 prose-ul:mt-2 prose-ol:pl-4 prose-ol:mt-2 prose-a:text-blue-600 hover:prose-a:text-blue-800 prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>
    </div>
  </article>

  <!-- Post Navigation -->
  <div class="mt-8 space-y-6" data-pagefind-ignore>
    <!-- Previous/Next Posts -->
    {(prevPost || nextPost) && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Previous Post -->
          <div class="text-left">
            {prevPost && (
              <div>
                <p class="text-sm text-gray-500 mb-2">Previous Post</p>
                <a
                  href={`/${getCleanSlug(prevPost)}`}
                  class="block text-blue-600 hover:text-blue-800 transition-colors"
                >
                  <div class="flex items-start space-x-3">
                    <svg class="w-5 h-5 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    <div>
                      <p class="font-medium line-clamp-2">{prevPost.data.title}</p>
                    </div>
                  </div>
                </a>
              </div>
            )}
          </div>

          <!-- Next Post -->
          <div class="text-right">
            {nextPost && (
              <div>
                <p class="text-sm text-gray-500 mb-2">Next Post</p>
                <a
                  href={`/${getCleanSlug(nextPost)}`}
                  class="block text-blue-600 hover:text-blue-800 transition-colors"
                >
                  <div class="flex items-start space-x-3 justify-end">
                    <div class="text-right">
                      <p class="font-medium line-clamp-2">{nextPost.data.title}</p>
                    </div>
                    <svg class="w-5 h-5 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
