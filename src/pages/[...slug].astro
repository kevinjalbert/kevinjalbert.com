---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DatedContentDisclaimer from '../components/DatedContentDisclaimer.astro';
import HeroImage from '../components/HeroImage.astro';
import PostHeader from '../components/PostHeader.astro';
import PostNavigation from '../components/PostNavigation.astro';
import { calculateReadTimeFromMarkdown } from '../utils/readTime';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  // Sort by date (newest first) using pubDate from frontmatter
  const sortedPosts = blogEntries.sort((a, b) => {
    const dateA = new Date(a.data.pubDate);
    const dateB = new Date(b.data.pubDate);
    return dateB.getTime() - dateA.getTime();
  });

  return sortedPosts.map((entry, index) => {
    // Get previous and next posts for navigation
    const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    const nextPost = index > 0 ? sortedPosts[index - 1] : null;

    return {
      params: { slug: entry.data.permalink },
      props: {
        entry,
        prevPost,
        nextPost
      },
    };
  });
}

const { entry, prevPost, nextPost } = Astro.props;
const { Content } = await entry.render();

// Calculate read time
const readTime = calculateReadTimeFromMarkdown(entry.body);

// Format date for Pagefind metadata
const publishDate = new Date(entry.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Generate canonical URL for this post
const canonicalURL = `https://kevinjalbert.com/${entry.data.permalink}/`;
---

<Layout title={entry.data.title} description={entry.data.description} canonical={canonicalURL}>
  <!-- Post Title - Outside the article but still indexed by pagefind -->
  <div class="text-center mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900" data-pagefind-meta="title">{entry.data.title}</h1>
  </div>

  <!-- Hero Image - Outside article container for faster loading -->
  <HeroImage
    heroImage={entry.data.heroImage}
    heroImageAlt={entry.data.heroImageAlt}
    pullImageAttribution={entry.data.pull_image_attribution}
    title={entry.data.title}
  />

  <article class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden" data-pagefind-body>
    <!-- Hidden metadata for Pagefind -->
    <div style="display: none;">
      <span data-pagefind-meta="date">{publishDate}</span>
      {entry.data.description && (
        <span data-pagefind-meta="description">{entry.data.description}</span>
      )}
    </div>

    <!-- Article Header -->
    <div class="p-3 sm:p-8 border-b border-gray-100">
      <!-- Metadata and Tags in a more compact layout -->
      <PostHeader
        pubDate={entry.data.pubDate}
        postBody={entry.body}
        tags={entry.data.tags}
      />
    </div>

    <!-- Article Content -->
    <div class="p-3 sm:p-8">
      <!-- Dated Content Disclaimer -->
      <DatedContentDisclaimer
        pubDate={entry.data.pubDate}
        tags={entry.data.tags}
        forceShowDatedDisclaimer={entry.data.forceShowDatedDisclaimer}
        forceHideDatedDisclaimer={entry.data.forceHideDatedDisclaimer}
      />

      <div class="prose max-w-none prose-headings:text-gray-900 prose-h1:mt-8 prose-h2:mt-6 prose-h3:mt-5 prose-h4:mt-4 [&>*:first-child]:mt-0 prose-li:my-1 prose-ul:pl-4 prose-ul:mt-2 prose-ol:pl-4 prose-ol:mt-2 prose-a:text-blue-600 hover:prose-a:text-blue-800 prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>
    </div>
  </article>

  <!-- Post Navigation -->
  <PostNavigation
    prevPost={prevPost}
    nextPost={nextPost}
  />
</Layout>
