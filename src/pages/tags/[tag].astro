---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTimeFromMarkdown } from '../../utils/readTime';

export async function getStaticPaths() {
  // Get all blog posts
  const blogPosts = await getCollection('blog');

  // Collect all unique tags and validate they are URL-safe
  const allTags = new Set();
  const problematicTags = [];

  blogPosts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => {
        allTags.add(tag);

        // Validate that tags are URL-safe and lowercase
        if (tag.includes(' ') ||
            tag !== encodeURIComponent(tag) ||
            /[^a-z0-9\-_]/.test(tag) ||
            tag !== tag.toLowerCase()) {
          problematicTags.push({
            tag,
            file: post.id,
            title: post.data.title
          });
        }
      });
    }
  });

  // Throw an error if any problematic tags are found
  if (problematicTags.length > 0) {
    const errorMessage = [
      'Found tags that are not lowercase or contain invalid characters:',
      ...problematicTags.map(({ tag, file, title }) =>
        `  - "${tag}" in ${file} (${title})`
      ),
      '',
      'Tags must be lowercase and contain only letters, numbers, hyphens, and underscores.',
      'Please convert to lowercase and replace spaces with hyphens.'
    ].join('\n');

    throw new Error(errorMessage);
  }

  // Generate paths for each tag
  const paths = [];

  Array.from(allTags).forEach(tag => {
    // Filter posts that have this tag
    const tagPosts = blogPosts.filter(post =>
      post.data.tags && post.data.tags.includes(tag)
    );

    // Sort by date (newest first) using pubDate from frontmatter
    const sortedPosts = tagPosts.sort((a, b) => {
      const dateA = new Date(a.data.pubDate);
      const dateB = new Date(b.data.pubDate);
      return dateB.getTime() - dateA.getTime();
    });

    // Since all tags are now URL-safe (no spaces or special characters),
    // we can use them directly as parameters
    paths.push({
      params: { tag: tag },
      props: {
        tag,
        posts: sortedPosts
      }
    });
  });

  return paths;
}

const { tag, posts } = Astro.props;

// Generate canonical URL for this tag page
const canonicalURL = `https://kevinjalbert.com/tags/${tag}/`;

// Helper function to format dates
function formatDate(pubDate) {
  return new Date(pubDate).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Helper function to generate clean URL slug
function getCleanSlug(post) {
  return post.data.permalink;
}
---

<Layout title={`Posts tagged "${tag}" | Kevin Jalbert's Blog`} description={`All blog posts tagged with "${tag}"`} canonical={canonicalURL}>
  <!-- Header -->
  <div class="mb-6">
    <div class="text-center mb-6">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">
        Posts tagged with <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-3xl">"{tag}"</span>
      </h1>
      <p class="text-lg text-gray-600">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} found
      </p>
    </div>
  </div>

  <!-- Posts List -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-3 sm:p-6">
    <div class="space-y-6">
      {posts.map((post) => {
        const publishDate = formatDate(post.data.pubDate);
        const readTime = calculateReadTimeFromMarkdown(post.body);
        const cleanSlug = getCleanSlug(post);

        return (
          <article class="border-b border-gray-100 last:border-b-0 pb-6 last:pb-0">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
              <h2 class="text-xl font-semibold flex-1 mb-1 sm:mb-0">
                <a
                  href={`/${cleanSlug}/`}
                  class="text-blue-600 hover:text-blue-800 transition-colors"
                >
                  {post.data.title}
                </a>
              </h2>
              <div class="flex items-center text-sm text-gray-500 sm:ml-4 flex-shrink-0 space-x-2">
                <time>{publishDate}</time>
                <span>•</span>
                <span>{readTime.text}</span>
              </div>
            </div>

            {post.data.description && (
              <p class="text-gray-600 mb-3">{post.data.description}</p>
            )}

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map(postTag => (
                  <a
                    href={`/tags/${postTag}/`}
                    class={`inline-block text-sm px-2 py-1 rounded-md transition-colors ${
                      postTag === tag
                        ? 'bg-blue-100 text-blue-800 font-medium'
                        : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                    }`}
                  >
                    {postTag}
                  </a>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</Layout>
