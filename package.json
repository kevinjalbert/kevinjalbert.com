{
  "name": "kevinjalbert-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "./scripts/sync-content.sh",
    "sync:push": "./scripts/sync-content.sh --push",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "check-links": "npm run check-links:self && npm run check-links:internal && npm run check-links:external",
    "check-links:internal": "astro build",
    "check-links:external": "markdown-link-check --quiet --config markdown-link-check.json src/content",
    "check-links:self": "(grep -r 'https://kevinjalbert\\.com/' src/content/ && echo 'ERROR: Found absolute links to own site. Use wikilinks instead.' && exit 1) || (grep -r '\\[.*\\](/[^)]*)' src/content/ && echo 'ERROR: Found relative links. Use wikilinks instead.' && exit 1) || echo 'No problematic internal links found.'",
    "check-dated": "node scripts/check-dated.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "astro": "^5.12.8",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/typography": "^0.5.16",
    "astro-broken-links-checker": "github:imazen/astro-broken-link-checker",
    "markdown-link-check": "^3.13.7",
    "pagefind": "^1.3.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^3.4.17",
    "unified": "^11.0.5",
    "vitest": "^3.2.4"
  }
}
